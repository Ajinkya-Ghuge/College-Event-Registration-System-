    { "source": "/main", "destination": "/main/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/team", "destination": "/team/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/event", "destination": "/event/index.html" },
    { "source": "/registration", "destination": "/registration/index.html" },
    { "source": "/payment", "destination": "/payment/index.html" }
  ]
}
